# Balluff BCM0003 raw acceleration BLOB reader configuration
# Correct variable names for balluff_bcm_blob_reader_v9_timeout_safe.py

# ICE2/ICE3 Modbus TCP connection
BCM_HOST=192.168.137.25
BCM_TCP_PORT=502
BCM_UNIT_ID=1
BCM_IOL_PORT=1

# Balluff raw acceleration provider, ISDU 0x219B
BCM_TRIGGER_SOURCE=2
BCM_TRIGGER_MODE=0
BCM_AXIS_SELECTION=6
BCM_TARGET=0

# BLOB_CH sizing and pacing
# 228 requested bytes = 1-byte BLOB header + normally 227 payload bytes.
# The v9 code applies BCM_BLOB_SEGMENT_GAP_S only once, immediately before
# each state-advancing BLOB_CH read. It no longer sleeps again after a segment.
BCM_MAX_ISDU_LEN=232
BCM_ISDU_DELAY_S=0.001
BCM_BLOB_SEGMENT_GAP_S=0.001
BCM_BLOB_RESPONSE_POLL_S=0.001
BCM_BLOB_RESPONSE_TIMEOUT_S=5.0
BCM_BLOB_TIMEOUT_S=1200.0

# Stateful BLOB_CH safety: keep retries disabled.
BCM_UNSAFE_BLOB_READ_RETRIES=0
BCM_BLOB_READ_RETRY_DELAY_S=0.50
BCM_DISABLE_BLOB_RESPONSE_FRESHNESS=false
BCM_UNSAFE_ALLOW_DISABLE_FRESHNESS=false
BCM_MAX_DUPLICATE_REREADS=20
BCM_FLOW_POLICY=strict

# Modbus transport
BCM_MODBUS_TIMEOUT_S=5.0
BCM_MODBUS_RETRIES=2
BCM_MODBUS_RETRY_DELAY_S=0.05

# Provider status polling
BCM_STATUS_TIMEOUT_S=120.0
BCM_STATUS_POLL_S=0.25

# Output/logging
BCM_OUTPUT_DIR=blob_output
BCM_ONCE=true
BCM_SKIP_CONFIG=false
BCM_NO_STARTUP_RECOVERY=false
BCM_DEBUG=false
BCM_LOG_FILE=blob_v9_timeout_safe.log
