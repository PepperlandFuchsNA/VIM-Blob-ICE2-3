# vim_blob_crc_reader.env
# Save this file next to vim_blob_crc_reader.py as:
#   vim_blob_crc_reader.env
# Then run:
#   python vim_blob_crc_reader.py

# ICE2/3 Modbus TCP connection
VIM_HOST=192.168.137.21
VIM_TCP_PORT=502
VIM_UNIT_ID=1
VIM_IOL_PORT=4

# IO-Link BLOB selection
# -4096 is encoded as 0xF000 and matches the original script.
VIM_BLOB_ID=-4096

# VIM capture settings
# SSC trigger:
# 0=Inactive, 1=SSC1.1 vRMS, 2=SSC1.2 vRMS,
# 3=SSC2.1 aRMS, 4=SSC2.2 aRMS,
# 5=SSC3.1 aPeak, 6=SSC3.2 aPeak,
# 7=SSC4.1 Temperature, 8=SSC4.2 Temperature,
# 9=SSC5.1 Crest, 10=SSC5.2 Crest,
# 11=SSC6.1 Bearing Condition, 12=SSC6.2 Bearing Condition
VIM_SSC_TRIGGER=0

# Raw sample rate:
# 0=64 kHz / 12 kHz low-pass
# 1=32 kHz / 6 kHz low-pass
# 2=16 kHz / 3 kHz low-pass
# 3=8 kHz / 1.5 kHz low-pass
# 4=4 kHz / 0.75 kHz low-pass
# 5=2 kHz / 0.3 kHz low-pass
VIM_SAMPLE_RATE=5

VIM_MEMORY_SIZE=10

# Set true if you do not want the script to rewrite indices 97, 98, and 101.
VIM_SKIP_CONFIG=false

# BLOB transfer timing/settings
VIM_MAX_ISDU_LEN=201
VIM_ISDU_DELAY=0.2

# Leave blank to use VIM recording time from index 99 plus VIM_RECORDING_BUFFER.
# Set a number, for example 8, to force an exact recording wait in seconds.
VIM_RECORDING_WAIT=
VIM_RECORDING_BUFFER=1.0

# The default false means the script sends one BLOB_Abort before BLOB_Start
# to clear a previous stuck transfer.
VIM_NO_INITIAL_ABORT=false

# Keep false if your script was hanging at "Waiting for blob capture to start".
VIM_USE_PDI_WAIT=false
VIM_POLL=0.1
VIM_START_TIMEOUT=60.0
VIM_FINISH_TIMEOUT=900.0

# Modbus socket timeout
VIM_TIMEOUT=5.0

# Output files
VIM_RAW_OUTPUT=blob_payload.bin
VIM_CSV_OUTPUT=g_values.csv

# Set true if you only want the raw verified BLOB and do not want CSV conversion.
VIM_NO_PARSE=false

# Set true to print raw ISDU/Modbus traffic.
VIM_DEBUG=false
