# Balluff BCM0003 raw acceleration BLOB reader settings

# ICE2/3 Modbus TCP settings
BCM_HOST=192.168.137.21
BCM_TCP_PORT=502
BCM_UNIT_ID=1
BCM_IOL_PORT=4

# Balluff raw acceleration provider configuration, index 8603
# Trigger source: 0 disabled, 1 process data, 2 ISDU, 3 Pin 2, 4 alarm/logic block
BCM_TRIGGER_SOURCE=2

# Trigger mode: 0 after trigger, 1 before and after trigger, 2 before trigger
BCM_TRIGGER_MODE=0

# Axis selection: 0 X, 1 Y, 2 Z, 3 X+Y, 4 X+Z, 5 Y+Z, 6 X+Y+Z
BCM_AXIS_SELECTION=6

# Target: 0 raw acceleration only, 1 spectrum only, 2 raw acceleration + spectrum
BCM_TARGET=0

# Timeouts and polling
BCM_STATUS_TIMEOUT_S=120
BCM_BLOB_TIMEOUT_S=600
BCM_POLL_S=0.25
BCM_ISDU_DELAY_S=0.2
BCM_MODBUS_TIMEOUT_S=5.0
BCM_MAX_ISDU_LEN=201

# Output
BCM_OUTPUT_DIR=.
BCM_SAVE_RAW_BIN=false

# Recovery / cleanup
BCM_NO_INITIAL_ABORT=false
BCM_NO_RESET_AT_END=false

# Diagnostics
BCM_DEBUG=false
