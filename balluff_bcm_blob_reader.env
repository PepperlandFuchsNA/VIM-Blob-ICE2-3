# Balluff BCM0003 raw acceleration BLOB reader configuration
# Place this file beside balluff_bcm_blob_reader_v8_manual_aligned.py.
# The script automatically loads the .env file with the same base name.

# ---------------------------------------------------------------------------
# ICE2/ICE3 Modbus TCP connection
# ---------------------------------------------------------------------------
BCM_HOST=192.168.137.23
BCM_TCP_PORT=502
BCM_UNIT_ID=1
BCM_IOL_PORT=1

# ---------------------------------------------------------------------------
# Balluff raw acceleration provider configuration, ISDU 0x219B
# Trigger source: 2 = ISDU data trigger
# Trigger mode:   0 = record after trigger
# Axis selection: 6 = X + Y + Z
# Target:         0 = raw acceleration only
# IMPORTANT: this script currently supports only target=0.
# ---------------------------------------------------------------------------
BCM_TRIGGER_SOURCE=2
BCM_TRIGGER_MODE=0
BCM_AXIS_SELECTION=6
BCM_TARGET=0

# ---------------------------------------------------------------------------
# BLOB_CH transfer sizing and timing
# Based on your live diagnostics, 33 bytes was the most stable short-read size.
# Keep this conservative while we are dealing with ICE mailbox 0x3001 stale data.
# ---------------------------------------------------------------------------
BLOB_START_SETTLE_TIME_S = 5.0
BLOB_STATUS_POLL_INTERVAL_S = 0.25
BLOB_SEGMENT_READ_DELAY_S = 0.25
ISDU_TIMEOUT_S = 30.0
MAX_CONSECUTIVE_ERRORS = 3
MAX_CONSECUTIVE_DUPLICATES = 3

# ---------------------------------------------------------------------------
# Stateful BLOB_CH safety
# The Balluff manual says BLOB_CH read requests trigger internal state changes
# and cannot be performed twice. Keep unsafe retries at 0 for normal use.
# ---------------------------------------------------------------------------
BCM_UNSAFE_BLOB_READ_RETRIES=0
BCM_BLOB_READ_RETRY_DELAY_S=0.50
BCM_DISABLE_BLOB_RESPONSE_FRESHNESS=false
BCM_UNSAFE_ALLOW_DISABLE_FRESHNESS=false
BCM_MAX_DUPLICATE_REREADS=20
BCM_FLOW_POLICY=warn

# ---------------------------------------------------------------------------
# Modbus transport
# ---------------------------------------------------------------------------
BCM_MODBUS_TIMEOUT_S=5.0
BCM_MODBUS_RETRIES=2
BCM_MODBUS_RETRY_DELAY_S=0.05

# ---------------------------------------------------------------------------
# Provider status polling
# ---------------------------------------------------------------------------
BCM_STATUS_TIMEOUT_S=120.0
BCM_STATUS_POLL_S=0.25

# ---------------------------------------------------------------------------
# Output/logging
# ---------------------------------------------------------------------------
BCM_OUTPUT_DIR=blob_output
BCM_ONCE=true
BCM_SKIP_CONFIG=false
BCM_NO_STARTUP_RECOVERY=false
BCM_DEBUG=false
BCM_LOG_FILE=blob_v8_manual_aligned.log
