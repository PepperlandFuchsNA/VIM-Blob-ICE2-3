# ICE3 connection
ICE_HOST=192.168.137.21
ICE_TCP_PORT=502
ICE_UNIT_ID=1
ICE_IOL_PORTS=1

# BLOB selection
# Use rawX first for commissioning. Use rawX,rawY,rawZ after rawX is stable.
# Use auto with DCAS_VALUE/DCT_VALUE to auto-select BLOBs.
BLOB_TYPES=rawX

# Balluff data provider configuration
DPTG_VALUE=2
RADPTM_VALUE=0
DCAS_VALUE=6
DCT_VALUE=0

# Timing
BLOB_TIMEOUT_S=180
BLOB_POLL_S=0.2
BLOB_PACKET_POLL_S=0.05

# Output/logging
SAVE_CSV=true
BLOB_OUTPUT_ROOT=blob_csv
BLOB_LOG_DIR=blob_logs
LOG_LEVEL=INFO

# ICE/ISDU behavior
WAIT_FOR_WRITE_RESPONSES=false
RESTART_BEFORE_CONFIG=true
CLEANUP_BEFORE_ACQUISITION=true
CLEANUP_ON_ERROR=true
CONTINUE_ON_BLOB_ERROR=false

# Acquisition behavior
# false = use current status intelligently; true = force a new configured capture.
FORCE_RECONFIGURE=false
REUSE_READY_DATA=true

# Transfer validation
STRICT_TRANSFER=true
VALIDATE_PACKET_COUNTER=true
VALIDATE_EXPECTED_LENGTH=true
# Leave BLOB_INFO_LENGTH_OFFSET blank unless you confirm the exact 0x10 packet layout.
BLOB_INFO_LENGTH_OFFSET=
BLOB_INFO_LENGTH_SIZE=4
TRIM_TO_EXPECTED_LENGTH=true

# Parallel runner only
PARALLEL_MAX_WORKERS=2
