# Balluff raw-acceleration FFT configuration

# Input CSV filename or path.
FFT_CSV_FILE="C:\Users\sbharucha\Modbus ICE2 Blob program\blob_output\round_001_20260629_104446_port1_x_raw_accel.csv"

# Name displayed in graph titles.
FFT_PLOT_NAME=Balluff BCM X-axis

# Select the section of the recording to process.
# FFT_START_SAMPLE is zero-based.
FFT_START_SAMPLE=0

# Number of samples to process.
# 0 = use the entire recording from FFT_START_SAMPLE onward.
# Good faster values: 16384, 32768, or 65536.
FFT_SAMPLE_COUNT=32768

# Output folder for PNG and CSV results.
FFT_OUTPUT_DIR=fft_output

# Maximum frequency for the zoomed FFT and peak table.
FFT_MAX_FREQUENCY_HZ=2000

# true = open plot windows; false = save files only.
FFT_SHOW=true
